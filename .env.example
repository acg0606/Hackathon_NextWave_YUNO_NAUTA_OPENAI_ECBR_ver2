# Server-only optional integrations. Copy names to .env.local and add values
# locally. Never commit .env.local or paste secret values into client code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_AGENT_TIMEOUT_MS=12000

AISSTREAM_API_KEY=

# Yuno Test Mode only. Production endpoints are intentionally unsupported.
YUNO_ENV=sandbox
YUNO_ACCOUNT_CODE=
YUNO_PUBLIC_API_KEY=
YUNO_PRIVATE_SECRET_KEY=
YUNO_TIMEOUT_MS=15000
